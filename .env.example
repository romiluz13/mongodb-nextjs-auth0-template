# Auth0 Configuration
# Generate a secret using: openssl rand -hex 32
AUTH0_SECRET="your-auth0-secret-at-least-32-chars-long"

# Your application's base URL - update for production
AUTH0_BASE_URL="http://localhost:3000"

# Auth0 Application configuration
AUTH0_ISSUER_BASE_URL="https://your-tenant.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"

# Auth0 Organization (optional - for multi-tenant applications)
# AUTH0_ORGANIZATION="your-auth0-organization-id"

# MongoDB Configuration
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI="your-mongodb-connection-string"

# Optional: MongoDB Database Name (if not specified in connection string)
# MONGODB_DB="your-database-name"

# Performance Monitoring (optional but recommended for production)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your-vercel-analytics-id"
NEXT_PUBLIC_SPEED_INSIGHTS_ID="your-speed-insights-id"

# Security (optional - for additional security headers)
# NEXT_PUBLIC_CSP_REPORT_ONLY="true"
# NEXT_PUBLIC_CSP_REPORT_URI="your-csp-report-endpoint"

# Node Environment
NODE_ENV="development" # or "production" for production builds

# Optional: Custom Domain Configuration (for production)
# NEXT_PUBLIC_CUSTOM_DOMAIN="your-custom-domain.com"

# Optional: Rate Limiting (recommended for production)
# RATE_LIMIT_REQUESTS=100 # requests per window
# RATE_LIMIT_WINDOW=60 # in seconds

# Optional: Logging Configuration
# LOG_LEVEL="info" # debug, info, warn, error

# Optional: Cache Configuration
# CACHE_TTL=3600 # in seconds
# REDIS_URL="your-redis-url" # if using Redis for caching

# Optional: MongoDB Connection Pool Configuration
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_IDLE_TIME_MS=30000

# Optional: API Timeouts
# API_TIMEOUT_MS=5000
# DB_TIMEOUT_MS=5000

# Remember:
# 1. Never commit .env files to version control
# 2. Keep secrets secret and rotate them regularly
# 3. Use different values for development and production
# 4. Make sure all team members have access to required credentials
# 5. Consider using a secrets manager for production environments 